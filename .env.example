# Token bot dari @BotFather
TELEGRAM_TOKEN=1234567890:ABCDefghIJKLmnopQRSTuvwxYZ

# Chat ID yang diizinkan (pisahkan dengan koma jika lebih dari satu)
# Cara dapat chat ID: kirim pesan ke @userinfobot
ALLOWED_CHAT_IDS=123456789

# ── OPSIONAL ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=bot.log
