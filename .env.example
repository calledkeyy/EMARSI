# Salin file ini ke .env dan isi nilainya
# cp .env.example .env

# ── WAJIB ─────────────────────────────────────────────────────
# Token bot dari @BotFather
TELEGRAM_TOKEN=1234567890:ABCDefghIJKLmnopQRSTuvwxYZ

# Chat ID yang diizinkan (pisahkan dengan koma jika lebih dari satu)
# Cara dapat chat ID: kirim pesan ke @userinfobot
ALLOWED_CHAT_IDS=123456789

# ── OPSIONAL ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=bot.log

# ── Binance Demo Trading API ───────────────────────────────────
# Buat API key di: https://demo.binance.com/my/settings/api-management
BINANCE_DEMO_API_KEY=your_demo_api_key_here
BINANCE_DEMO_API_SECRET=your_demo_api_secret_here

# Auto-trade settings
AUTO_TRADE_ENABLED=true
TRADE_RISK_USD=5.0
TRADE_LEVERAGE=20
TRADE_MIN_CONFIDENCE=7
BALANCE_SAFETY_PCT=0.9
